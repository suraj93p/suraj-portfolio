{
  "name": "suraj-pasayat-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Suraj Pasayat: a data-driven React, TypeScript and SCSS portfolio with offline PWA support.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite --open",
    "start": "npm run dev",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prebuild": "npm run assets",
    "build": "npm run typecheck && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "serve": "npm run build && npm run preview",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run lint && npm run test:coverage && npm run build && npm run test:e2e",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:5173 --http-host-header localhost:5173",
    "tunnel:preview": "cloudflared tunnel --url http://127.0.0.1:4173 --http-host-header localhost:4173",
    "cloudflared": "npm run tunnel",
    "share": "node scripts/share.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test:pwa-adapter": "node scripts/test-pwa-adapter.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.57.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "sass": "1.93.2",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
